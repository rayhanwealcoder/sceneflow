# Copy to .env — these defaults match the local Postgres 17 install.
DATABASE_URL=postgresql://postgres:sceneflow_dev@localhost:5432/sceneflow
SESSION_SECRET=change-me-to-a-long-random-string-32-chars
PORT=4800
PUBLIC_URL=http://localhost:4800
WEB_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=2048

# Storage: "local" keeps files on this machine (default). "s3" works with Cloudflare R2, AWS S3, MinIO, Backblaze B2.
# The worker must use the same values.
STORAGE_PROVIDER=local
STORAGE_DIR=../../data
# S3_BUCKET=sceneflow-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.yourdomain.com/public
# S3_FORCE_PATH_STYLE=false

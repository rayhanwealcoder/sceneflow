# Copy to .env — these defaults match the local Postgres 17 install.
DATABASE_URL=postgresql://postgres:sceneflow_dev@localhost:5432/sceneflow
SESSION_SECRET=change-me-to-a-long-random-string-32-chars
PORT=4800
PUBLIC_URL=http://localhost:4800
WEB_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=2048
# Set to true ONLY behind Nginx / Cloudflare, so rate limits and the sign-in guard see the real client IP.
TRUST_PROXY=false

# Storage: "local" keeps files on this machine (default). "s3" works with Cloudflare R2, AWS S3, MinIO, Backblaze B2.
# The worker must use the same values.
STORAGE_PROVIDER=local
STORAGE_DIR=../../data
# S3_BUCKET=sceneflow-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.yourdomain.com/public
# S3_FORCE_PATH_STYLE=false

# AI (all optional). Without keys: starter script/copy text + the server's built-in voices (Windows/macOS; espeak-ng on Linux).
# ANTHROPIC_API_KEY=sk-ant-...        # real scripts, storyboards and copy (Claude)
# AI_MODEL=claude-opus-5-5
# ELEVENLABS_API_KEY=...              # natural voiceovers + captions transcribed from audio
# ELEVENLABS_VOICE_ID=                # default voice (optional)
# AI_TEXT_PROVIDER=auto               # auto | anthropic | starter
# AI_SPEECH_PROVIDER=auto             # auto | elevenlabs | system | off

# E-mail (optional). Without it, password-reset links and invitations are written to the API log and to <STORAGE_DIR>/outbox
# as JSON (the person running the server copies the link). With one of these, real mail goes out:
# MAIL_FROM="SceneFlow <no-reply@yourdomain.com>"   # required for Resend / SMTP; the domain must be verified at the provider
# RESEND_API_KEY=re_...                             # https://resend.com - HTTP API, the free tier covers a small team
# SMTP_URL=smtps://user:password@smtp.yourhost.com:465   # ...or any SMTP server (smtp://host:587 uses STARTTLS)
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_SECURE=false   # separate fields instead of SMTP_URL
# MAIL_PROVIDER=auto                                # auto | resend | smtp | log
# MAIL_OUTBOX_DIR=                                  # where the outbox fallback writes (default <STORAGE_DIR>/outbox)

# Playback analytics: raw events older than this many days are deleted every 6 hours (0 = keep forever).
# 395 days = 13 months, enough to compare a month with the same month last year. Shop orders are kept.
# ANALYTICS_RETENTION_DAYS=395

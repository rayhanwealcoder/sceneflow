DATABASE_URL=postgresql://postgres:sceneflow_dev@localhost:5432/sceneflow
PUBLIC_URL=http://localhost:4800
SESSION_SECRET=change-me-to-a-long-random-string-32-chars

# Must match apps/api/.env (local disk or the same S3/R2 bucket).
STORAGE_PROVIDER=local
STORAGE_DIR=../../data
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# MP4 export renders in headless Google Chrome (not Chromium: H.264 video needs Chrome). The installed Chrome is
# found automatically; set the path when it lives somewhere unusual, e.g. /usr/bin/google-chrome-stable.
# EXPORT_BROWSER=

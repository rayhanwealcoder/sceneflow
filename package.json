{
  "name": "sceneflow",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "bootstrap": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:connectors": "node scripts/build-connectors.mjs",
    "build:wp": "node scripts/build-connectors.mjs --only wordpress",
    "test:wp": "php connectors/wordpress/sceneflow/tests/run.php",
    "check:wp": "node scripts/check-wp.mjs",
    "format:wp": "node scripts/check-wp.mjs --fix",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "admin": "pnpm --silent --filter @sceneflow/api admin",
    "db:generate": "pnpm --filter @sceneflow/server db:generate"
  },
  "devDependencies": {
    "@wordpress/prettier-config": "4",
    "playwright-core": "1.50.1",
    "prettier": "npm:wp-prettier@3.0.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23"
    }
  }
}

{
  "name": "sceneflow",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "bootstrap": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:connectors": "node scripts/build-connectors.mjs",
    "build:wp": "node scripts/build-connectors.mjs --only wordpress",
    "test:wp": "php connectors/wordpress/sceneflow/tests/run.php",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @sceneflow/server db:generate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.8"
  }
}
